# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# `.env.test` ships well-known local Supabase dev credentials (deterministic
# JWTs from `supabase start`) needed by Vitest integration tests — Constitution
# §III. These values do NOT grant access to any Cloud project and are safe to
# commit. See .env.test header for details.
!.env.test
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Added by MoMorph
.mcp.json
mcp.json

# Claude Code (local overrides)
.claude/settings.local.json

# IDE / editor
.idea/
*.swp
*.swo

# OS metadata (explicit; also catches nested folders)
**/.DS_Store
