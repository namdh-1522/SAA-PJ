# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Service role key — REQUIRED for `npm run seed:kudos`. Bypasses RLS.
# Lấy từ Supabase Dashboard → Project Settings → API → service_role secret.
# Tuyệt đối KHÔNG commit hay expose ra browser. Chỉ dùng trong server scripts.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Route to redirect authenticated users to after login
NEXT_PUBLIC_POST_AUTH_URL=/about-saa-2025

# Gate-lift date: the moment the prelaunch holding page stops being served and the SAA app opens
# Format: ISO-8601 with timezone offset e.g. 2026-06-07T18:30:00+07:00
NEXT_PUBLIC_PRELAUNCH_END=2026-06-07T18:30:00+07:00

# Award ceremony date: the target the Homepage SAA countdown counts down to
# This is independent of NEXT_PUBLIC_PRELAUNCH_END (typically one month later)
NEXT_PUBLIC_SAA_EVENT_START=2026-07-07T18:30:00+07:00
